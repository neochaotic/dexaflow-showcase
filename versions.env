# Pinned versions and names. Every script sources this file, so bumping a
# version here bumps it everywhere, and any value can be overridden from the
# environment (e.g. DEXAFLOW_VERSION=0.5.3 make up). Dexaflow Pro is pre-1.0:
# read the upstream upgrade guide before changing DEXAFLOW_VERSION.
DEXAFLOW_VERSION="${DEXAFLOW_VERSION:-0.5.3}"
DEXAFLOW_CHART="${DEXAFLOW_CHART:-oci://ghcr.io/dexadata/charts/dexaflow}"
POSTGRES_IMAGE="${POSTGRES_IMAGE:-postgres:16-alpine}"
REDIS_IMAGE="${REDIS_IMAGE:-redis:7-alpine}"
K3S_IMAGE="${K3S_IMAGE:-rancher/k3s:v1.31.5-k3s1}"

# Names used by the local (k3d) environment.
CLUSTER_NAME="${CLUSTER_NAME:-dexaflow-showcase}"
NAMESPACE="${NAMESPACE:-dexaflow}"
RELEASE="${RELEASE:-dexaflow}"
REGISTRY_NAME="${REGISTRY_NAME:-k3d-showcase-registry.localhost}"
REGISTRY_PORT="${REGISTRY_PORT:-5050}"
LOCAL_UI_PORT="${LOCAL_UI_PORT:-8080}"

# The bootstrap admin signs in with this email, not with "admin".
ADMIN_EMAIL="${ADMIN_EMAIL:-admin@leoflow.local}"

# Defaults for the GKE environment. Override any of them in the environment,
# e.g. `GCP_PROJECT=my-project ZONE=europe-west1-b make gke-up`.
GKE_CLUSTER="${GKE_CLUSTER:-dexaflow-showcase}"
GKE_REGION="${GKE_REGION:-us-central1}"
GKE_ZONE="${GKE_ZONE:-us-central1-a}"
GKE_MACHINE_TYPE="${GKE_MACHINE_TYPE:-e2-standard-2}"
GKE_MAX_NODES="${GKE_MAX_NODES:-3}"
# Spot nodes cost about a third, but Google can reclaim them at any time, which
# restarts the whole platform mid-lab. Regular nodes by default; GKE_SPOT=true
# for a cheaper cluster that may restart.
GKE_SPOT="${GKE_SPOT:-false}"
GKE_UI_PORT="${GKE_UI_PORT:-8081}"
BQ_DATASET="${BQ_DATASET:-dexaflow_showcase}"

# BigQuery lab (labs/bigquery). The dataset is created in GCP_PROJECT.
LAB_DATASET="${LAB_DATASET:-dexaflow_lab}"
LAB_LOCATION="${LAB_LOCATION:-US}"

# Pushes DAG images from a container where the Docker daemon cannot reach the
# registry (Cloud Shell and Artifact Registry).
CRANE_IMAGE="gcr.io/go-containerregistry/crane:debug"
